generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum RawSyncStatus {
  FETCHED
  NORMALIZED
  ERROR
}

enum FinancialRecordStatus {
  VALID
  SUPERSEDED
  VOID
}

enum ObligationReviewDecision {
  APPROVED
  REJECTED
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum SyncRunType {
  FULL
  PICKUP
  DISPATCH
  COD
}

enum OperationalExpenseStatus {
  VALID
  VOID
}

enum OperationalClosingStatus {
  OPEN
  REOPENED
  CLOSED
}

model Tenant {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String                      @unique
  status                     TenantStatus                @default(ACTIVE)
  timezone                   String                      @default("Asia/Jakarta")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  outlets                    Outlet[]
  users                      User[]
  roles                      Role[]
  sessions                   UserSession[]
  auditLogs                  AuditLog[]
  integrationCredentials     IntegrationCredential[]
  rawPickups                 RawPickup[]
  rawDispatches              RawDispatch[]
  rawCodRecords              RawCod[]
  masterPickups              MasterPickup[]
  masterSetoran              MasterSetoran[]
  pickupSettlementRevisions  PickupSettlementRevision[]
  pickupPayments             PickupPayment[]
  courierSettlementPayments  CourierSettlementPayment[]
  courierSettlementTransfers CourierSettlementTransfer[]
  syncRuns                   SyncRun[]
  operationalExpenses        OperationalExpense[]
  operationalClosings        OperationalClosing[]
  operationalActionRequests  OperationalActionRequest[]
}

model Outlet {
  id                         String                      @id @default(uuid()) @db.Uuid
  tenantId                   String                      @db.Uuid
  code                       String
  name                       String
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                      User[]
  sessions                   UserSession[]
  auditLogs                  AuditLog[]
  rawPickups                 RawPickup[]
  rawDispatches              RawDispatch[]
  rawCodRecords              RawCod[]
  masterPickups              MasterPickup[]
  masterSetoran              MasterSetoran[]
  pickupSettlementRevisions  PickupSettlementRevision[]
  pickupPayments             PickupPayment[]
  courierSettlementPayments  CourierSettlementPayment[]
  courierSettlementTransfers CourierSettlementTransfer[]
  syncRuns                   SyncRun[]
  operationalExpenses        OperationalExpense[]
  operationalClosings        OperationalClosing[]
  operationalActionRequests  OperationalActionRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model User {
  id                                  String                      @id @default(uuid()) @db.Uuid
  tenantId                            String                      @db.Uuid
  outletId                            String?                     @db.Uuid
  email                               String
  name                                String
  passwordHash                        String
  status                              UserStatus                  @default(ACTIVE)
  lastLoginAt                         DateTime?
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  tenant                              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet                              Outlet?                     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  roles                               UserRole[]
  sessions                            UserSession[]
  auditLogs                           AuditLog[]                  @relation("AuditActor")
  pickupSettlementRevisionsCreated    PickupSettlementRevision[]  @relation("PickupSettlementCreatedBy")
  pickupSettlementRevisionsUpdated    PickupSettlementRevision[]  @relation("PickupSettlementUpdatedBy")
  pickupSettlementRevisionsVoided     PickupSettlementRevision[]  @relation("PickupSettlementVoidedBy")
  pickupPaymentsCreated               PickupPayment[]             @relation("PickupPaymentCreatedBy")
  pickupPaymentsUpdated               PickupPayment[]             @relation("PickupPaymentUpdatedBy")
  pickupPaymentsVoided                PickupPayment[]             @relation("PickupPaymentVoidedBy")
  masterSetoranReviewed               MasterSetoran[]             @relation("MasterSetoranReviewedBy")
  courierPaymentsCreated              CourierSettlementPayment[]  @relation("CourierPaymentCreatedBy")
  courierPaymentsUpdated              CourierSettlementPayment[]  @relation("CourierPaymentUpdatedBy")
  courierPaymentsVoided               CourierSettlementPayment[]  @relation("CourierPaymentVoidedBy")
  courierPaymentsOverpaymentConfirmed CourierSettlementPayment[]  @relation("CourierPaymentOverpaymentConfirmedBy")
  courierTransfersCreated             CourierSettlementTransfer[] @relation("CourierTransferCreatedBy")
  courierTransfersUpdated             CourierSettlementTransfer[] @relation("CourierTransferUpdatedBy")
  syncRunsTriggered                   SyncRun[]                   @relation("SyncRunTriggeredBy")
  operationalExpensesCreated          OperationalExpense[]        @relation("OperationalExpenseCreatedBy")
  operationalExpensesUpdated          OperationalExpense[]        @relation("OperationalExpenseUpdatedBy")
  operationalExpensesVoided           OperationalExpense[]        @relation("OperationalExpenseVoidedBy")
  operationalClosingsClosed           OperationalClosing[]        @relation("OperationalClosingClosedBy")
  operationalClosingsReopened         OperationalClosing[]        @relation("OperationalClosingReopenedBy")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, outletId])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  outletId   String?  @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet     Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  tenantId   String      @db.Uuid
  actorId    String?     @db.Uuid
  outletId   String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  outlet     Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt(sort: Desc)])
}

model IntegrationCredential {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  provider         String
  label            String
  encryptedPayload String
  keyVersion       Int      @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, label])
  @@index([tenantId, provider, isActive])
}

model SyncRun {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  outletId             String        @db.Uuid
  runType              SyncRunType
  operationalDate      DateTime      @db.Date
  status               SyncRunStatus @default(RUNNING)
  startedAt            DateTime      @db.Timestamptz(3)
  completedAt          DateTime?     @db.Timestamptz(3)
  triggeredByUserId    String?       @db.Uuid
  pickupFetchedCount   Int           @default(0)
  pickupCreatedCount   Int           @default(0)
  pickupUpdatedCount   Int           @default(0)
  dispatchFetchedCount Int           @default(0)
  dispatchCreatedCount Int           @default(0)
  dispatchUpdatedCount Int           @default(0)
  codFetchedCount      Int           @default(0)
  codCreatedCount      Int           @default(0)
  codUpdatedCount      Int           @default(0)
  duplicateCount       Int           @default(0)
  anomalyCount         Int           @default(0)
  errorMessage         String?
  metadata             Json?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  triggeredBy          User?         @relation("SyncRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  firstSeenPickups     RawPickup[]   @relation("RawPickupFirstSeenRun")
  lastSeenPickups      RawPickup[]   @relation("RawPickupLastSeenRun")
  firstSeenDispatches  RawDispatch[] @relation("RawDispatchFirstSeenRun")
  lastSeenDispatches   RawDispatch[] @relation("RawDispatchLastSeenRun")
  firstSeenCodRecords  RawCod[]      @relation("RawCodFirstSeenRun")
  lastSeenCodRecords   RawCod[]      @relation("RawCodLastSeenRun")

  @@unique([tenantId, outletId, id])
  @@index([tenantId, outletId, startedAt])
  @@index([tenantId, outletId, operationalDate])
  @@index([status])
}

model RawPickup {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  outletId         String        @db.Uuid
  operationalDate  DateTime      @db.Date
  sourceEndpoint   String
  sourceRecordKey  String
  sourceFetchedAt  DateTime      @db.Timestamptz(3)
  syncedAt         DateTime?     @db.Timestamptz(3)
  syncStatus       RawSyncStatus @default(FETCHED)
  syncError        String?
  sourceRecordHash String        @db.Char(64)
  sourcePayload    Json
  firstSeenRunId   String        @db.Uuid
  lastSeenRunId    String        @db.Uuid
  waybillNo        String
  pickNetwork      String?
  destination      String?
  settlementRaw    String?
  totalFreight     Decimal       @db.Decimal(18, 2)
  freight          Decimal       @db.Decimal(18, 2)
  weight           Decimal       @db.Decimal(12, 3)
  staffNameRaw     String?
  senderName       String?
  serviceRaw       String?
  receiverName     String?
  receiverAddress  String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet           Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  firstSeenRun     SyncRun       @relation("RawPickupFirstSeenRun", fields: [tenantId, outletId, firstSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)
  lastSeenRun      SyncRun       @relation("RawPickupLastSeenRun", fields: [tenantId, outletId, lastSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)
  masterPickup     MasterPickup?

  @@unique([tenantId, outletId, sourceRecordKey])
  @@index([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, waybillNo])
  @@index([tenantId, outletId, syncStatus])
  @@index([firstSeenRunId])
  @@index([lastSeenRunId])
}

model RawDispatch {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  outletId          String        @db.Uuid
  operationalDate   DateTime      @db.Date
  sourceEndpoint    String
  sourceRecordKey   String
  sourceFetchedAt   DateTime      @db.Timestamptz(3)
  syncedAt          DateTime?     @db.Timestamptz(3)
  syncStatus        RawSyncStatus @default(FETCHED)
  syncError         String?
  sourceRecordHash  String        @db.Char(64)
  sourcePayload     Json
  firstSeenRunId    String        @db.Uuid
  lastSeenRunId     String        @db.Uuid
  waybillNo         String
  courierNameRaw    String?
  freightAmount     Decimal       @db.Decimal(18, 2)
  dispatchTimeRaw   String?
  dispatchAt        DateTime?     @db.Timestamptz(3)
  receiverName      String?
  receiverAddress   String?
  deliveryStatusRaw String?
  chargeWeight      Decimal       @db.Decimal(12, 3)
  settlementTypeRaw String?
  serviceRaw        String?
  codStatusRaw      String?
  codValue          Decimal       @db.Decimal(18, 2)
  goodsDescription  String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  firstSeenRun      SyncRun       @relation("RawDispatchFirstSeenRun", fields: [tenantId, outletId, firstSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)
  lastSeenRun       SyncRun       @relation("RawDispatchLastSeenRun", fields: [tenantId, outletId, lastSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)

  @@unique([tenantId, outletId, sourceRecordKey])
  @@index([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, waybillNo])
  @@index([tenantId, outletId, courierNameRaw, operationalDate])
  @@index([tenantId, outletId, syncStatus])
  @@index([firstSeenRunId])
  @@index([lastSeenRunId])
}

model RawCod {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  outletId            String        @db.Uuid
  operationalDate     DateTime      @db.Date
  sourceEndpoint      String
  sourceRecordKey     String
  sourceFetchedAt     DateTime      @db.Timestamptz(3)
  syncedAt            DateTime?     @db.Timestamptz(3)
  syncStatus          RawSyncStatus @default(FETCHED)
  syncError           String?
  sourceRecordHash    String        @db.Char(64)
  sourcePayload       Json
  firstSeenRunId      String        @db.Uuid
  lastSeenRunId       String        @db.Uuid
  waybillNo           String
  codAmount           Decimal       @db.Decimal(18, 2)
  repaymentStatusRaw  Json
  repaymentStatusCode Int?
  repaymentTypeRaw    Json
  repaymentTypeCode   Int?
  repaymentTypeLabel  String?
  signTimeRaw         String?
  signedAt            DateTime?     @db.Timestamptz(3)
  courierNameRaw      String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet              Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  firstSeenRun        SyncRun       @relation("RawCodFirstSeenRun", fields: [tenantId, outletId, firstSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)
  lastSeenRun         SyncRun       @relation("RawCodLastSeenRun", fields: [tenantId, outletId, lastSeenRunId], references: [tenantId, outletId, id], onDelete: Restrict)

  @@unique([tenantId, outletId, sourceRecordKey])
  @@index([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, waybillNo])
  @@index([tenantId, outletId, courierNameRaw, operationalDate])
  @@index([tenantId, outletId, syncStatus])
  @@index([firstSeenRunId])
  @@index([lastSeenRunId])
}

model MasterPickup {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @db.Uuid
  outletId             String                     @db.Uuid
  rawPickupId          String                     @unique @db.Uuid
  operationalDate      DateTime                   @db.Date
  waybillNo            String
  staffName            String?
  senderName           String?
  freightAmount        Decimal                    @db.Decimal(18, 2)
  syncStatus           RawSyncStatus              @default(NORMALIZED)
  normalizationVersion Int                        @default(1)
  sourceSyncedAt       DateTime                   @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet                     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  rawPickup            RawPickup                  @relation(fields: [rawPickupId], references: [id], onDelete: Restrict)
  settlementRevisions  PickupSettlementRevision[]
  payments             PickupPayment[]

  @@unique([tenantId, outletId, waybillNo])
  @@index([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, staffName, operationalDate])
}

model PickupSettlementRevision {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @db.Uuid
  outletId             String                     @db.Uuid
  masterPickupId       String                     @db.Uuid
  requestKey           String?                    @db.Uuid
  revision             Int
  recordStatus         FinancialRecordStatus      @default(VALID)
  supersedesRevisionId String?                    @db.Uuid
  discountAmount       Decimal                    @db.Decimal(18, 2)
  reason               String?
  voidedAt             DateTime?                  @db.Timestamptz(3)
  voidedByUserId       String?                    @db.Uuid
  voidReason           String?
  createdByUserId      String                     @db.Uuid
  updatedByUserId      String                     @db.Uuid
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet                     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  masterPickup         MasterPickup               @relation(fields: [masterPickupId], references: [id], onDelete: Restrict)
  supersedesRevision   PickupSettlementRevision?  @relation("PickupSettlementSupersession", fields: [supersedesRevisionId], references: [id], onDelete: Restrict)
  supersededBy         PickupSettlementRevision[] @relation("PickupSettlementSupersession")
  createdBy            User                       @relation("PickupSettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User                       @relation("PickupSettlementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  voidedBy             User?                      @relation("PickupSettlementVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@unique([masterPickupId, revision])
  @@unique([tenantId, outletId, requestKey])
  @@index([tenantId, outletId, masterPickupId, recordStatus])
}

model PickupPayment {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  outletId            String                @db.Uuid
  masterPickupId      String                @db.Uuid
  transactionKey      String                @db.Uuid
  revision            Int
  recordStatus        FinancialRecordStatus @default(VALID)
  supersedesPaymentId String?               @db.Uuid
  paymentDate         DateTime              @db.Date
  receivedAmount      Decimal               @db.Decimal(18, 2)
  paymentMethodRaw    String
  transferAccount     String?
  note                String?
  voidedAt            DateTime?             @db.Timestamptz(3)
  voidedByUserId      String?               @db.Uuid
  voidReason          String?
  createdByUserId     String                @db.Uuid
  updatedByUserId     String                @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet              Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  masterPickup        MasterPickup          @relation(fields: [masterPickupId], references: [id], onDelete: Restrict)
  supersedesPayment   PickupPayment?        @relation("PickupPaymentSupersession", fields: [supersedesPaymentId], references: [id], onDelete: Restrict)
  supersededBy        PickupPayment[]       @relation("PickupPaymentSupersession")
  createdBy           User                  @relation("PickupPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User                  @relation("PickupPaymentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  voidedBy            User?                 @relation("PickupPaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@unique([transactionKey, revision])
  @@index([tenantId, outletId, paymentDate])
  @@index([tenantId, outletId, masterPickupId, recordStatus])
}

model MasterSetoran {
  id                       String                     @id @default(uuid()) @db.Uuid
  tenantId                 String                     @db.Uuid
  outletId                 String                     @db.Uuid
  operationalDate          DateTime                   @db.Date
  courierKey               String
  courierName              String
  dfodAmount               Decimal                    @db.Decimal(18, 2)
  codCashAmount            Decimal                    @db.Decimal(18, 2)
  codQrisAmount            Decimal                    @db.Decimal(18, 2)
  totalSettlementAmount    Decimal                    @db.Decimal(18, 2)
  previousObligationAmount Decimal?                   @db.Decimal(18, 2)
  proposedDfodAmount       Decimal?                   @db.Decimal(18, 2)
  proposedCodCashAmount    Decimal?                   @db.Decimal(18, 2)
  proposedCodQrisAmount    Decimal?                   @db.Decimal(18, 2)
  proposedObligationAmount Decimal?                   @db.Decimal(18, 2)
  needsReview              Boolean                    @default(false)
  obligationVersion        Int                        @default(1)
  reviewedByUserId         String?                    @db.Uuid
  reviewedAt               DateTime?                  @db.Timestamptz(3)
  reviewDecision           ObligationReviewDecision?
  reviewNote               String?
  syncStatus               RawSyncStatus              @default(NORMALIZED)
  normalizationVersion     Int                        @default(1)
  sourceFetchedFrom        DateTime                   @db.Timestamptz(3)
  sourceFetchedTo          DateTime                   @db.Timestamptz(3)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(3)
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet                   Outlet                     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  reviewedBy               User?                      @relation("MasterSetoranReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  payments                 CourierSettlementPayment[]

  @@unique([tenantId, outletId, operationalDate, courierKey])
  @@index([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, courierName, operationalDate])
}

model CourierSettlementPayment {
  id                           String                      @id @default(uuid()) @db.Uuid
  tenantId                     String                      @db.Uuid
  outletId                     String                      @db.Uuid
  masterSetoranId              String                      @db.Uuid
  transactionKey               String                      @db.Uuid
  revision                     Int
  recordStatus                 FinancialRecordStatus       @default(VALID)
  supersedesPaymentId          String?                     @db.Uuid
  paymentDate                  DateTime                    @db.Date
  cashAmount                   Decimal                     @db.Decimal(18, 2)
  transferAmountSnapshot       Decimal                     @db.Decimal(18, 2)
  paidAmountSnapshot           Decimal                     @db.Decimal(18, 2)
  note                         String?
  overpaymentConfirmedAt       DateTime?                   @db.Timestamptz(3)
  overpaymentConfirmedByUserId String?                     @db.Uuid
  voidedAt                     DateTime?                   @db.Timestamptz(3)
  voidedByUserId               String?                     @db.Uuid
  voidReason                   String?
  createdByUserId              String                      @db.Uuid
  updatedByUserId              String                      @db.Uuid
  createdAt                    DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @db.Timestamptz(3)
  tenant                       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet                       Outlet                      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  masterSetoran                MasterSetoran               @relation(fields: [masterSetoranId], references: [id], onDelete: Restrict)
  supersedesPayment            CourierSettlementPayment?   @relation("CourierPaymentSupersession", fields: [supersedesPaymentId], references: [id], onDelete: Restrict)
  supersededBy                 CourierSettlementPayment[]  @relation("CourierPaymentSupersession")
  overpaymentConfirmedBy       User?                       @relation("CourierPaymentOverpaymentConfirmedBy", fields: [overpaymentConfirmedByUserId], references: [id], onDelete: Restrict)
  voidedBy                     User?                       @relation("CourierPaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdBy                    User                        @relation("CourierPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                    User                        @relation("CourierPaymentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  transfers                    CourierSettlementTransfer[]

  @@unique([transactionKey, revision])
  @@index([tenantId, outletId, masterSetoranId, recordStatus])
  @@index([tenantId, outletId, paymentDate])
}

model CourierSettlementTransfer {
  id                   String                      @id @default(uuid()) @db.Uuid
  tenantId             String                      @db.Uuid
  outletId             String                      @db.Uuid
  settlementPaymentId  String                      @db.Uuid
  transactionKey       String                      @db.Uuid
  sequence             Int
  revision             Int                         @default(1)
  recordStatus         FinancialRecordStatus       @default(VALID)
  supersedesTransferId String?                     @db.Uuid
  amount               Decimal                     @db.Decimal(18, 2)
  destinationAccount   String?
  bankName             String?
  referenceNumber      String?
  transferredAt        DateTime?                   @db.Timestamptz(3)
  note                 String?
  createdByUserId      String                      @db.Uuid
  updatedByUserId      String                      @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet                      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  settlementPayment    CourierSettlementPayment    @relation(fields: [settlementPaymentId], references: [id], onDelete: Restrict)
  supersedesTransfer   CourierSettlementTransfer?  @relation("CourierTransferSupersession", fields: [supersedesTransferId], references: [id], onDelete: Restrict)
  supersededBy         CourierSettlementTransfer[] @relation("CourierTransferSupersession")
  createdBy            User                        @relation("CourierTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User                        @relation("CourierTransferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([transactionKey, revision])
  @@index([tenantId, outletId, settlementPaymentId, sequence, recordStatus])
  @@index([tenantId, outletId, referenceNumber])
}

model OperationalExpense {
  id                  String                   @id @default(uuid()) @db.Uuid
  tenantId            String                   @db.Uuid
  outletId            String                   @db.Uuid
  operationalDate     DateTime                 @db.Date
  category            String
  amount              Decimal                  @db.Decimal(18, 2)
  description         String?
  teamName            String?
  cashAdvanceCategory String?
  vehiclePlate        String?
  status              OperationalExpenseStatus @default(VALID)
  createdByUserId     String                   @db.Uuid
  updatedByUserId     String                   @db.Uuid
  voidedByUserId      String?                  @db.Uuid
  voidedAt            DateTime?                @db.Timestamptz(3)
  voidReason          String?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet              Outlet                   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  createdBy           User                     @relation("OperationalExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User                     @relation("OperationalExpenseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  voidedBy            User?                    @relation("OperationalExpenseVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, operationalDate, status])
  @@index([tenantId, outletId, category, operationalDate])
  @@index([tenantId, outletId, teamName, operationalDate])
}

model OperationalClosing {
  id                                 String                   @id @default(uuid()) @db.Uuid
  tenantId                           String                   @db.Uuid
  outletId                           String                   @db.Uuid
  operationalDate                    DateTime                 @db.Date
  snapshotVersion                    Int                      @default(0)
  cashCollectedSnapshot              Decimal                  @default(0) @db.Decimal(18, 2)
  transferCollectedSnapshot          Decimal                  @default(0) @db.Decimal(18, 2)
  outstandingSnapshot                Decimal                  @default(0) @db.Decimal(18, 2)
  operationalExpenseSnapshot         Decimal                  @default(0) @db.Decimal(18, 2)
  cashAvailableBeforeDepositSnapshot Decimal                  @default(0) @db.Decimal(18, 2)
  bankDepositAmount                  Decimal                  @default(0) @db.Decimal(18, 2)
  bankDepositAccount                 String?
  bankDepositReference               String?
  bankDepositNote                    String?
  remainingCashAfterDepositSnapshot  Decimal                  @default(0) @db.Decimal(18, 2)
  physicalCash                       Decimal                  @default(0) @db.Decimal(18, 2)
  cashVariance                       Decimal                  @default(0) @db.Decimal(18, 2)
  varianceStatus                     String                   @default("MATCH")
  status                             OperationalClosingStatus @default(OPEN)
  version                            Int                      @default(1)
  closedByUserId                     String?                  @db.Uuid
  closedAt                           DateTime?                @db.Timestamptz(3)
  reopenedByUserId                   String?                  @db.Uuid
  reopenedAt                         DateTime?                @db.Timestamptz(3)
  reopenReason                       String?
  createdAt                          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                 @updatedAt @db.Timestamptz(3)
  tenant                             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet                             Outlet                   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  closedBy                           User?                    @relation("OperationalClosingClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  reopenedBy                         User?                    @relation("OperationalClosingReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, outletId, operationalDate])
  @@index([tenantId, outletId, status, operationalDate])
}

model OperationalActionRequest {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  outletId   String   @db.Uuid
  requestKey String   @db.Uuid
  action     String
  entityId   String?
  response   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@unique([tenantId, outletId, requestKey])
  @@index([tenantId, outletId, action, createdAt])
}
