generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  SETTINGS_TARGET_KPI_UPDATED
}

enum ProfitLossDirection {
  INCOME
  EXPENSE
}

enum ProfitLossEntryStatus {
  ACTIVE
  VOID
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum RawSyncStatus {
  FETCHED
  NORMALIZED
  ERROR
}

enum FinancialRecordStatus {
  VALID
  SUPERSEDED
  VOID
}

enum ObligationReviewDecision {
  APPROVED
  REJECTED
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum SyncRunType {
  FULL
  PICKUP
  DISPATCH
  COD
}

enum JfsCashflowTrigger {
  MANUAL
  CRON
}

enum OperationalExpenseStatus {
  VALID
  VOID
}

enum OperationalClosingStatus {
  OPEN
  REOPENED
  CLOSED
}

enum CashDirection {
  IN
  OUT
}

enum CashChannel {
  CASH
  BANK
}

enum CashMovementType {
  PICKUP_PAYMENT
  DELIVERY_PAYMENT
  BANK_DEPOSIT
  OPERATIONAL_EXPENSE
  CASH_WITHDRAWAL
  MANUAL_INCOME
  MANUAL_EXPENSE
  REFUND
  ADJUSTMENT
  TRANSFER
}

enum CashMovementStatus {
  VALID
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
}

enum SalaryDivision {
  ADMIN
  ADMIN_OPS
  SALES
  THREE_WHEEL_DRIVER
  MOTORIST
  DRIVER
}

enum SalaryEmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TeamMembershipStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  SICK
  PERMISSION
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  CORRECTION
}

enum LeaveRequestType {
  LEAVE
  PERMISSION
  SICK
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SalaryProfileStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SalaryAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum SalaryClosingStatus {
  DRAFT
  CLOSED
  COMPLETED
  PROCESSED
  PAID
  VOID
}

enum SalaryClosingEmployeeStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWED
  PROCESSED
  PAID
}

enum SalaryComponentType {
  INCOME
  DEDUCTION
}

enum SalaryComponentSourceType {
  BASIC
  OVERTIME
  FIXED_ALLOWANCE
  DELIVERY_PER_KG
  DELIVERY_PER_WAYBILL
  PICKUP_REGULAR_PERCENTAGE
  PICKUP_REGULAR_PER_WAYBILL
  PICKUP_MARKETPLACE_PER_WAYBILL
  DAILY_FUEL
  DAILY_EXTRA
  MANUAL_ADDITION
  MANUAL_DEDUCTION
  OTHER
}

enum SalaryAdjustmentType {
  ADDITION
  DEDUCTION
}

enum SalaryAliasSourceType {
  PICKUP
  DISPATCH
  BOTH
}

enum SalarySourceType {
  PICKUP
  DISPATCH
}

enum SalarySourceCalculationStatus {
  INCLUDED
  EXCLUDED
  UNMATCHED
}

enum SalaryKasbonAllocationStatus {
  DRAFT
  FINALIZED
  VOID
}

model Tenant {
  id                         String                         @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String                         @unique
  adminWhatsapp              String?
  address                    String?
  phone                      String?
  email                      String?
  status                     TenantStatus                   @default(ACTIVE)
  timezone                   String                         @default("Asia/Jakarta")
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  outlets                    Outlet[]
  users                      User[]
  roles                      Role[]
  sessions                   UserSession[]
  auditLogs                  AuditLog[]
  integrationCredentials     IntegrationCredential[]
  rawPickups                 RawPickup[]
  rawDispatches              RawDispatch[]
  rawCodRecords              RawCod[]
  masterPickups              MasterPickup[]
  masterSetoran              MasterSetoran[]
  pickupSettlementRevisions  PickupSettlementRevision[]
  pickupPayments             PickupPayment[]
  courierSettlementPayments  CourierSettlementPayment[]
  courierSettlementTransfers CourierSettlementTransfer[]
  syncRuns                   SyncRun[]
  operationalExpenses        OperationalExpense[]
  operationalClosings        OperationalClosing[]
  operationalActionRequests  OperationalActionRequest[]
  cashMovements              CashMovement[]
  rawSlaCutOffs              RawSlaCutOff[]
  rawInventoryDetails        RawInventoryDetail[]
  rawWaybillStatuses         RawWaybillStatus[]
  rawPickupSchedules         RawPickupSchedule[]
  invoices                   Invoice[]
  invoiceItems               InvoiceItem[]
  invoiceSequences           InvoiceSequence[]
  outletBankAccounts         OutletBankAccount[]
  salaryEmployees            SalaryEmployee[]
  salaryProfiles             SalaryProfile[]
  salaryProfileSettings      SalaryProfileSetting[]
  salaryAssignments          EmployeeSalaryAssignment[]
  salaryClosings             SalaryClosing[]
  salaryClosingEmployees     SalaryClosingEmployee[]
  salaryClosingComponents    SalaryClosingComponent[]
  salaryClosingSnapshots     SalaryClosingProfileSnapshot[]
  salaryAdjustments          SalaryAdjustment[]
  salaryClosingSequences     SalaryClosingSequence[]
  salaryEmployeeAliases      SalaryEmployeeAlias[]
  salaryClosingSources       SalaryClosingSourceRecord[]
  salaryKasbonAllocations    SalaryKasbonAllocation[]
  salaryPublicationShares    SalaryPublicationShare[]
  jfsCashflowRecords         JfsCashflowRecord[]
  jfsCashflowSyncRuns        JfsCashflowSyncRun[]
  jfsCashflowSyncLocks       JfsCashflowSyncLock[]
  profitLossManualEntries    ProfitLossManualEntry[]
  profitLossAdjustments      ProfitLossAdjustment[]
  financialCategories        FinancialCategory[]
  teamMemberships            TeamMembership[]
  operationalTargetSettings  OperationalTargetSetting[]
  attendanceLocationSettings AttendanceLocationSetting[]
  attendanceRecords          AttendanceRecord[]
  attendanceEvents           AttendanceEvent[]
  leaveRequests              LeaveRequest[]
}

model Outlet {
  id                         String                         @id @default(uuid()) @db.Uuid
  tenantId                   String                         @db.Uuid
  code                       String
  name                       String
  adminWhatsapp              String?
  address                    String?
  phone                      String?
  email                      String?
  isActive                   Boolean                        @default(true)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                      User[]
  sessions                   UserSession[]
  auditLogs                  AuditLog[]
  rawPickups                 RawPickup[]
  rawDispatches              RawDispatch[]
  rawCodRecords              RawCod[]
  masterPickups              MasterPickup[]
  masterSetoran              MasterSetoran[]
  pickupSettlementRevisions  PickupSettlementRevision[]
  pickupPayments             PickupPayment[]
  courierSettlementPayments  CourierSettlementPayment[]
  courierSettlementTransfers CourierSettlementTransfer[]
  syncRuns                   SyncRun[]
  operationalExpenses        OperationalExpense[]
  operationalClosings        OperationalClosing[]
  operationalActionRequests  OperationalActionRequest[]
  cashMovements              CashMovement[]
  rawSlaCutOffs              RawSlaCutOff[]
  rawInventoryDetails        RawInventoryDetail[]
  rawWaybillStatuses         RawWaybillStatus[]
  rawPickupSchedules         RawPickupSchedule[]
  invoices                   Invoice[]
  invoiceItems               InvoiceItem[]
  invoiceSequences           InvoiceSequence[]
  bankAccounts               OutletBankAccount[]
  salaryEmployees            SalaryEmployee[]
  salaryProfiles             SalaryProfile[]
  salaryProfileSettings      SalaryProfileSetting[]
  salaryAssignments          EmployeeSalaryAssignment[]
  salaryClosings             SalaryClosing[]
  salaryClosingEmployees     SalaryClosingEmployee[]
  salaryClosingComponents    SalaryClosingComponent[]
  salaryClosingSnapshots     SalaryClosingProfileSnapshot[]
  salaryAdjustments          SalaryAdjustment[]
  salaryClosingSequences     SalaryClosingSequence[]
  salaryEmployeeAliases      SalaryEmployeeAlias[]
  salaryClosingSources       SalaryClosingSourceRecord[]
  salaryKasbonAllocations    SalaryKasbonAllocation[]
  salaryPublicationShares    SalaryPublicationShare[]
  jfsCashflowRecords         JfsCashflowRecord[]
  jfsCashflowSyncRuns        JfsCashflowSyncRun[]
  jfsCashflowSyncLocks       JfsCashflowSyncLock[]
  profitLossManualEntries    ProfitLossManualEntry[]
  profitLossAdjustments      ProfitLossAdjustment[]
  financialCategories        FinancialCategory[]
  teamMemberships            TeamMembership[]
  operationalTargetSettings  OperationalTargetSetting[]
  attendanceLocationSetting  AttendanceLocationSetting?
  attendanceRecords          AttendanceRecord[]
  attendanceEvents           AttendanceEvent[]
  leaveRequests              LeaveRequest[]
  integrationCredentials     IntegrationCredential[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model User {
  id                                  String                      @id @default(uuid()) @db.Uuid
  tenantId                            String                      @db.Uuid
  outletId                            String?                     @db.Uuid
  email                               String
  name                                String
  passwordHash                        String
  status                              UserStatus                  @default(ACTIVE)
  lastLoginAt                         DateTime?
  avatarStorageKey                    String?
  avatarUpdatedAt                     DateTime?
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  tenant                              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet                              Outlet?                     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  roles                               UserRole[]
  sessions                            UserSession[]
  auditLogs                           AuditLog[]                  @relation("AuditActor")
  pickupSettlementRevisionsCreated    PickupSettlementRevision[]  @relation("PickupSettlementCreatedBy")
  pickupSettlementRevisionsUpdated    PickupSettlementRevision[]  @relation("PickupSettlementUpdatedBy")
  pickupSettlementRevisionsVoided     PickupSettlementRevision[]  @relation("PickupSettlementVoidedBy")
  pickupPaymentsCreated               PickupPayment[]             @relation("PickupPaymentCreatedBy")
  pickupPaymentsUpdated               PickupPayment[]             @relation("PickupPaymentUpdatedBy")
  pickupPaymentsVoided                PickupPayment[]             @relation("PickupPaymentVoidedBy")
  masterSetoranReviewed               MasterSetoran[]             @relation("MasterSetoranReviewedBy")
  courierPaymentsCreated              CourierSettlementPayment[]  @relation("CourierPaymentCreatedBy")
  courierPaymentsUpdated              CourierSettlementPayment[]  @relation("CourierPaymentUpdatedBy")
  courierPaymentsVoided               CourierSettlementPayment[]  @relation("CourierPaymentVoidedBy")
  courierPaymentsOverpaymentConfirmed CourierSettlementPayment[]  @relation("CourierPaymentOverpaymentConfirmedBy")
  courierTransfersCreated             CourierSettlementTransfer[] @relation("CourierTransferCreatedBy")
  courierTransfersUpdated             CourierSettlementTransfer[] @relation("CourierTransferUpdatedBy")
  syncRunsTriggered                   SyncRun[]                   @relation("SyncRunTriggeredBy")
  operationalExpensesCreated          OperationalExpense[]        @relation("OperationalExpenseCreatedBy")
  operationalExpensesUpdated          OperationalExpense[]        @relation("OperationalExpenseUpdatedBy")
  operationalExpensesVoided           OperationalExpense[]        @relation("OperationalExpenseVoidedBy")
  operationalClosingsClosed           OperationalClosing[]        @relation("OperationalClosingClosedBy")
  operationalClosingsReopened         OperationalClosing[]        @relation("OperationalClosingReopenedBy")
  cashMovementsCreated                CashMovement[]              @relation("CashMovementCreatedBy")
  invoicesCreated                     Invoice[]                   @relation("InvoiceCreatedBy")
  salaryProfilesCreated               SalaryProfile[]             @relation("SalaryProfileCreatedBy")
  salaryAssignmentsCreated            EmployeeSalaryAssignment[]  @relation("SalaryAssignmentCreatedBy")
  salaryClosingsCreated               SalaryClosing[]             @relation("SalaryClosingCreatedBy")
  salaryClosingsClosed                SalaryClosing[]             @relation("SalaryClosingClosedBy")
  salaryClosingsProcessed             SalaryClosing[]             @relation("SalaryClosingProcessedBy")
  salaryAdjustmentsCreated            SalaryAdjustment[]          @relation("SalaryAdjustmentCreatedBy")
  salaryAdjustmentsVoided             SalaryAdjustment[]          @relation("SalaryAdjustmentVoidedBy")
  salaryKasbonAllocationsCreated      SalaryKasbonAllocation[]    @relation("SalaryKasbonAllocationCreatedBy")
  salaryKasbonAllocationsVoided       SalaryKasbonAllocation[]    @relation("SalaryKasbonAllocationVoidedBy")
  salaryClosingsVoided                SalaryClosing[]             @relation("SalaryClosingVoidedBy")
  salaryPublicationSharesCreated      SalaryPublicationShare[]    @relation("SalaryPublicationShareCreatedBy")
  salaryPublicationSharesPublished    SalaryPublicationShare[]    @relation("SalaryPublicationSharePublishedBy")
  profitLossManualEntriesCreated      ProfitLossManualEntry[]     @relation("ProfitLossManualCreatedBy")
  profitLossManualEntriesVoided       ProfitLossManualEntry[]     @relation("ProfitLossManualVoidedBy")
  profitLossAdjustmentsCreated        ProfitLossAdjustment[]      @relation("ProfitLossAdjustmentCreatedBy")
  profitLossAdjustmentsVoided         ProfitLossAdjustment[]      @relation("ProfitLossAdjustmentVoidedBy")
  teamMemberships                     TeamMembership[]
  operationalTargetSettingsUpdated    OperationalTargetSetting[]  @relation("OperationalTargetSettingUpdatedBy")
  attendanceLocationsUpdated          AttendanceLocationSetting[] @relation("AttendanceLocationUpdatedBy")
  attendanceRecordsCorrected          AttendanceRecord[]          @relation("AttendanceRecordCorrectedBy")
  attendanceEventsActed               AttendanceEvent[]           @relation("AttendanceEventActor")
  leaveRequestsReviewed               LeaveRequest[]              @relation("LeaveRequestReviewer")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, outletId])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  outletId   String?  @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet     Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  tenantId   String      @db.Uuid
  actorId    String?     @db.Uuid
  outletId   String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  outlet     Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt(sort: Desc)])
}

enum IntegrationConnectionStatus {
  CONNECTED
  DISCONNECTED
  FAILED
}

model IntegrationCredential {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @db.Uuid
  outletId          String                      @db.Uuid
  provider          String                      @default("JFS")
  accountEncrypted  String
  passwordEncrypted String
  networkCode       String?
  networkName       String?
  financeCode       String?
  financeId         Int?
  scanSiteCode      String?
  connectionStatus  IntegrationConnectionStatus @default(DISCONNECTED)
  lastConnectedAt   DateTime?
  lastTestedAt      DateTime?
  lastFailureAt     DateTime?
  lastFailureCode   String?
  keyVersion        Int                         @default(1)
  isActive          Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet            Outlet                      @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([tenantId, outletId, provider])
  @@index([tenantId, outletId, provider, isActive])
}

model SyncRun {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  outletId             String        @db.Uuid
  runType              SyncRunType
  operationalDate      DateTime      @db.Date
  status               SyncRunStatus @default(RUNNING)
  startedAt            DateTime      @db.Timestamptz(3)
  completedAt          DateTime?     @db.Timestamptz(3)
  triggeredByUserId    String?       @db.Uuid
  pickupFetchedCount   Int           @default(0)
  pickupCreatedCount   Int           @default(0)
  pickupUpdatedCount   Int           @default(0)
  dispatchFetchedCount Int           @default(0)
  dispatchCreatedCount Int           @default(0)
  dispatchUpdatedCount Int           @default(0)
  codFetchedCount      Int           @default(0)
  codCreatedCount      Int           @default(0)
  codUpdatedCount      Int           @default(0)
  duplicateCount       Int           @default(0)
  anomalyCount         Int           @default(0)
  errorMessage         String?
  metadata             Json?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  triggeredBy          User?         @relation("SyncRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  firstSeenPickups     RawPickup[]   @relation("RawPickupFirstSeenRun")
  lastSeenPickups      RawPickup[]   @relation("RawPickupLastSeenRun")
  firstSeenDispatches  RawDispatch[] @relation("RawDispatchFirstSeenRun")
  lastSeenDispatches   RawDispatch[] @relation("RawDispatchLastSeenRun")
  firstSeenCodRecords  RawCod[]      @relation("RawCodFirstSeenRun")
  lastSeenCodRecords   RawCod[]      @relation("RawCodLastSeenRun")

  @@unique([tenantId, outletId, id])
  @@index([tenantId, outletId, startedAt])
  @@index([tenantId, outletId, operationalDate])
  @@index([status])
}

model JfsCashflowSyncRun {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  outletId         String              @db.Uuid
  periodStart      DateTime            @db.Date
  periodEnd        DateTime            @db.Date
  triggerSource    JfsCashflowTrigger
  status           SyncRunStatus       @default(RUNNING)
  fetchedCount     Int                 @default(0)
  uniqueCount      Int                 @default(0)
  createdCount     Int                 @default(0)
  updatedCount     Int                 @default(0)
  skippedCount     Int                 @default(0)
  anomalyCount     Int                 @default(0)
  startedAt        DateTime            @db.Timestamptz(3)
  completedAt      DateTime?           @db.Timestamptz(3)
  requestId        String              @unique
  errorCode        String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet           Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  firstSeenRecords JfsCashflowRecord[] @relation("JfsCashflowFirstSeenRun")
  lastSeenRecords  JfsCashflowRecord[] @relation("JfsCashflowLastSeenRun")

  @@index([tenantId, outletId, startedAt])
  @@index([tenantId, outletId, periodStart, periodEnd])
  @@index([status])
}

model JfsCashflowRecord {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  outletId          String             @db.Uuid
  businessDate      DateTime           @db.Date
  direction         String
  transactionType   String
  category          String
  amount            Decimal            @db.Decimal(18, 2)
  sourceReference   String?
  sourceRecordKey   String
  sourcePayloadHash String
  firstSeenRunId    String             @db.Uuid
  lastSeenRunId     String             @db.Uuid
  fetchedAt         DateTime           @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet             @relation(fields: [outletId], references: [id], onDelete: Restrict)
  firstSeenRun      JfsCashflowSyncRun @relation("JfsCashflowFirstSeenRun", fields: [firstSeenRunId], references: [id], onDelete: Restrict)
  lastSeenRun       JfsCashflowSyncRun @relation("JfsCashflowLastSeenRun", fields: [lastSeenRunId], references: [id], onDelete: Restrict)

  @@unique([tenantId, outletId, sourceRecordKey])
  @@index([tenantId, outletId, businessDate])
  @@index([tenantId, outletId, direction, businessDate])
}

model JfsCashflowSyncLock {
  tenantId     String   @db.Uuid
  outletId     String   @db.Uuid
  businessDate DateTime @db.Date
  requestId    String
  acquiredAt   DateTime @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([tenantId, outletId, businessDate])
  @@index([requestId])
}

model ProfitLossManualEntry {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  outletId        String                @db.Uuid
  entryDate       DateTime              @db.Date
  entryType       ProfitLossDirection
  category        String
  description     String
  amount          Decimal               @db.Decimal(18, 2)
  reference       String?
  status          ProfitLossEntryStatus @default(ACTIVE)
  createdByUserId String                @db.Uuid
  voidedAt        DateTime?             @db.Timestamptz(3)
  voidedByUserId  String?               @db.Uuid
  voidReason      String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("ProfitLossManualCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy        User?                 @relation("ProfitLossManualVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, entryDate])
  @@index([tenantId, outletId, entryType, status])
}

model ProfitLossAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  outletId        String                @db.Uuid
  adjustmentDate  DateTime              @db.Date
  direction       ProfitLossDirection
  category        String
  description     String
  amount          Decimal               @db.Decimal(18, 2)
  reason          String
  status          ProfitLossEntryStatus @default(ACTIVE)
  createdByUserId String                @db.Uuid
  voidedAt        DateTime?             @db.Timestamptz(3)
  voidedByUserId  String?               @db.Uuid
  voidReason      String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("ProfitLossAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
