{
  "manifest_version": 3,
  "name": "NEXTGEN DEV — JFS Waybill Helper",
  "version": "0.1.0",
  "description": "Membuka helper Pickup NEXTGEN DEV setelah pembuatan waybill JFS berhasil.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://jfs.jtcargo.co.id/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://jfs.jtcargo.co.id/*"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
